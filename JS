function inicializarAudio() {
    if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        gainMusica = audioCtx.createGain();
        gainMusica.gain.value = Number(rangeMusica.value) / 100 * 0.7;
        gainMusica.connect(audioCtx.destination);

        gainSfx = audioCtx.createGain();
        gainSfx.gain.value = Number(rangeSfx.value) / 100;
        gainSfx.connect(audioCtx.destination);

        iniciarTrilhaSonora();
    }
    if (audioCtx.state === "suspended") {
        audioCtx.resume();
    }
}

["click", "touchstart", "keydown", "mousemove"].forEach(evento => {
    window.addEventListener(evento, () => {
        if (!audioCtx || audioCtx.state !== "running") {
            inicializarAudio();
        }
    }, { once: true });
});

function iniciarTrilhaSonora() {
    if (timerMusica) return;
    const melodia = [330.00, 392.00, 440.00, 523.25, 440.00, 392.00, 329.63, 293.66];

    timerMusica = setInterval(() => {
        if (!audioCtx || audioCtx.state !== "running") return;

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = "triangle";
        const nota = melodia[passoRitmo % melodia.length];
        osc.frequency.setValueAtTime(nota, audioCtx.currentTime);

        const volAtual = (Number(rangeMusica.value) / 100) * 0.25;
        gain.gain.setValueAtTime(volAtual, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.4);

        osc.connect(gain);
        gain.connect(gainMusica);

        osc.start();
        osc.stop(audioCtx.currentTime + 0.4);

        passoRitmo++;
    }, 500);
}

function tocarSomClique() {
    inicializarAudio();
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(600, audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(350, audioCtx.currentTime + 0.08);
    gain.gain.setValueAtTime((Number(rangeSfx.value) / 100) * 0.3, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
    osc.connect(gain);
    gain.connect(gainSfx);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.08);
}

function tocarSomVirar() {
    inicializarAudio();
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(400, audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(700, audioCtx.currentTime + 0.1);
    gain.gain.setValueAtTime((Number(rangeSfx.value) / 100) * 0.3, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
    osc.connect(gain);
    gain.connect(gainSfx);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.1);
}

function tocarSomAcerto() {
    inicializarAudio();
    if (!audioCtx) return;
    const now = audioCtx.currentTime;
    [523.25, 659.25, 783.99].forEach((freq, i) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(freq, now + i * 0.08);
        gain.gain.setValueAtTime((Number(rangeSfx.value) / 100) * 0.3, now + i * 0.08);
        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.2);
        osc.connect(gain);
        gain.connect(gainSfx);
        osc.start(now + i * 0.08);
        osc.stop(now + i * 0.08 + 0.2);
    });
}

function tocarSomErro() {
    inicializarAudio();
    if (!audioCtx) return;
    const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = "sawtooth";
    osc.frequency.setValueAtTime(180, now);
    osc.frequency.linearRampToValueAtTime(110, now + 0.2);
    gain.gain.setValueAtTime((Number(rangeSfx.value) / 100) * 0.3, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
    osc.connect(gain);
    gain.connect(gainSfx);
    osc.start(now);
    osc.stop(now + 0.2);
}

