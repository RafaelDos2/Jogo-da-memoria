function voltarAoMenu() {
    if (tempoDeEspera) clearTimeout(tempoDeEspera);
    telaJogo.classList.add("escondido");
    telaMenu.classList.remove("escondido");
}

function iniciarJogo() {
    telaMenu.classList.add("escondido");
    telaJogo.classList.remove("escondido");

    cartasViradas = [];
    paresEncontrados = 0;
    pontosJogador = 0;
    pontosIA = 0;
    turno = "jogador";
    bloqueado = false;
    partidaEncerrada = false;
    memoriaIA.clear();
    cartasConhecidasIA.clear();

    totalCelulasPartida = gridTamanho;
    totalParesDaPartida = totalCelulasPartida / 2;

    atualizarPainel();
    configurarLayoutTabuleiro();
    gerarCartas();
}

function atualizarPainel() {
    elementoPares.textContent = `${paresEncontrados} / ${totalParesDaPartida}`;
    elementoPontosJogador.textContent = pontosJogador;
    elementoPontosIA.textContent = pontosIA;

    let nomeDif = dificuldadeEscolhida.charAt(0).toUpperCase() + dificuldadeEscolhida.slice(1);
    let nomeTema = temaEscolhido.charAt(0).toUpperCase() + temaEscolhido.slice(1);
    elementoDificuldade.textContent = `${nomeDif} • ${nomeTema}`;

    // Atualiza o texto do rodapé e aplica a cor correspondente (Azul para jogador, Cinza para IA)
    if (turno === "jogador") {
        mensagemJogo.textContent = "Sua vez! Escolha duas cartas.";
        mensagemJogo.className = "turno-jogador";
    } else {
        mensagemJogo.textContent = "Vez da IA pensando...";
        mensagemJogo.className = "turno-ia";
    }
}

function configurarLayoutTabuleiro() {
    tabuleiro.innerHTML = "";
    let colunas = 2;
    if (gridTamanho === 12) colunas = 4;
    else if (gridTamanho === 16) colunas = 4;
    else if (gridTamanho === 20) colunas = 5;
    else if (gridTamanho === 36) colunas = 6;

    tabuleiro.style.gridTemplateColumns = `repeat(${colunas}, minmax(0, 1fr))`;
}

function gerarCartas() {
    const figurasTema = temasFiguras[temaEscolhido];
    const qtdPares = totalParesDaPartida;

    // Embaralha e pega apenas a quantidade de figuras necessárias
    const figurasEmbaralhadas = [...figurasTema].sort(() => Math.random() - 0.5);
    const selecionadas = figurasEmbaralhadas.slice(0, qtdPares);
    const cartasItens = [...selecionadas, ...selecionadas].sort(() => Math.random() - 0.5);

    cartasItens.forEach((figura, index) => {
        const carta = document.createElement("button");
        carta.classList.add("carta");
        carta.setAttribute("type", "button");
        carta.dataset.valor = figura;
        carta.dataset.index = index;

        carta.innerHTML = `
            <div class="frente-carta">❓</div>
            <div class="verso-carta">${figura}</div>
        `;

        carta.addEventListener("click", () => clicarCarta(carta));
        tabuleiro.appendChild(carta);
    });
}

function clicarCarta(carta) {
    if (bloqueado || partidaEncerrada) return;
    if (turno !== "jogador") return;
    if (carta.classList.contains("virada") || carta.classList.contains("encontrada")) return;
    if (cartasViradas.includes(carta)) return;

    tocarSomVirar();
    carta.classList.add("virada");
    cartasViradas.push(carta);

    // Registra na memória da IA
    const idx = carta.dataset.index;
    const val = carta.dataset.valor;
    memoriaIA.set(idx, val);
    cartasConhecidasIA.add(idx);

    if (cartasViradas.length === 2) {
        bloqueado = true;
        verificarPar();
    }
}

function verificarPar() {
    const [carta1, carta2] = cartasViradas;
    const val1 = carta1.dataset.valor;
    const val2 = carta2.dataset.valor;

    if (val1 === val2) {
        tocarSomAcerto();
        paresEncontrados++;

        if (turno === "jogador") {
            pontosJogador += 10;
            carta1.classList.add("encontrada");
            carta2.classList.add("encontrada");
        } else {
            pontosIA += 10;
            carta1.classList.add("encontrada-ia");
            carta2.classList.add("encontrada-ia");
        }

        carta1.disabled = true;
        carta2.disabled = true;

        cartasViradas = [];
        atualizarPainel();

        if (paresEncontrados === totalParesDaPartida) {
            finalizarPartida();
        } else {
            bloqueado = false;
            // Se a IA acertou, ela joga de novo
            if (turno === "ia") {
                tempoDeEspera = setTimeout(jogadaIA, 1000);
            }
        }
    } else {
        tocarSomErro();
        carta1.classList.add("erro");
        carta2.classList.add("erro");

        tempoDeEspera = setTimeout(() => {
            carta1.classList.remove("virada", "erro");
            carta2.classList.remove("virada", "erro");
            cartasViradas = [];
            bloqueado = false;

            // Troca o turno
            turno = turno === "jogador" ? "ia" : "jogador";
            atualizarPainel();

            if (turno === "ia") {
                tempoDeEspera = setTimeout(jogadaIA, 1000);
            }
        }, 1000);
    }
}

function jogadaIA() {
    if (partidaEncerrada) return;
    bloqueado = true;
    atualizarPainel();

    tempoDeEspera = setTimeout(() => {
        if (partidaEncerrada) return;

        const cartasDisponiveis = Array.from(document.querySelectorAll(".carta:not(:disabled):not(.virada)"));
        if (cartasDisponiveis.length === 0) return;

        let primeiraEscolha = null;
        let segundaEscolha = null;

        // Estratégia da IA baseada na dificuldade e memória
        let chanceAcerto = 0.3; // Fácil
        if (dificuldadeEscolhida === "normal") chanceAcerto = 0.6;
        if (dificuldadeEscolhida === "dificil" || dificuldadeEscolhida === "aleatorio") chanceAcerto = 0.95;

        // Tenta achar um par conhecido na memória
        if (Math.random() < chanceAcerto) {
            let paresConhecidos = encontrarParNaMemoria(cartasDisponiveis);
            if (paresConhecidos) {
                primeiraEscolha = paresConhecidos[0];
                segundaEscolha = paresConhecidos[1];
            }
        }

        // Se não achou par na memória, escolhe aleatório
        if (!primeiraEscolha) {
            primeiraEscolha = cartasDisponiveis[Math.floor(Math.random() * cartasDisponiveis.length)];
            cartasConhecidasIA.add(primeiraEscolha.dataset.index);
            memoriaIA.set(primeiraEscolha.dataset.index, primeiraEscolha.dataset.valor);
        }

        tocarSomVirar();
        primeiraEscolha.classList.add("virada");
        cartasViradas.push(primeiraEscolha);

        tempoDeEspera = setTimeout(() => {
            if (partidaEncerrada) return;

            if (!segundaEscolha) {
                // Tenta achar o par da primeira carta na memória
                const val1 = primeiraEscolha.dataset.valor;
                const idx1 = primeiraEscolha.dataset.index;
                let cartaEncontradaPar = null;

                for (let [idx, val] of memoriaIA.entries()) {
                    if (val === val1 && idx !== idx1) {
                        let elem = document.querySelector(`.carta[data-index='${idx}']:not(:disabled):not(.virada)`);
                        if (elem) {
                            cartaEncontradaPar = elem;
                            break;
                        }
                    }
                }

                if (cartaEncontradaPar && Math.random() < chanceAcerto) {
                    segundaEscolha = cartaEncontradaPar;
                } else {
                    const restantes = cartasDisponiveis.filter(c => c !== primeiraEscolha);
                    segundaEscolha = restantes[Math.floor(Math.random() * restantes.length)];
                }
            }

            tocarSomVirar();
            segundaEscolha.classList.add("virada");
            cartasViradas.push(segundaEscolha);

            const idx2 = segundaEscolha.dataset.index;
            const val2 = segundaEscolha.dataset.valor;
            memoriaIA.set(idx2, val2);
            cartasConhecidasIA.add(idx2);

            tempoDeEspera = setTimeout(() => {
                verificarPar();
            }, 900);

        }, 800);

    }, 800);
}

function encontrarParNaMemoria(disponiveis) {
    let mapaValores = new Map();
    for (let carta of disponiveis) {
        let val = carta.dataset.valor;
        if (mapaValores.has(val)) {
            return [mapaValores.get(val), carta];
        }
        mapaValores.set(val, carta);
    }
    return null;
}

function finalizarPartida() {
    partidaEncerrada = true;
    if (tempoDeEspera) clearTimeout(tempoDeEspera);

    statTotalCartas.textContent = totalCelulasPartida;
    statPares.textContent = `${paresEncontrados} / ${totalParesDaPartida}`;
    statPtsJogador.textContent = pontosJogador;
    statPtsIA.textContent = pontosIA;

    if (pontosJogador > pontosIA) {
        tituloVitoria.textContent = "🎉 Você Venceu a IA!";
        subtituloVitoria.textContent = "Parabéns, sua memória foi superior!";
    } else if (pontosIA > pontosJogador) {
        tituloVitoria.textContent = "🤖 A IA Venceu!";
        subtituloVitoria.textContent = "Não foi dessa vez, tente novamente!";
    } else {
        tituloVitoria.textContent = "🤝 Empate!";
        subtituloVitoria.textContent = "Vocês jogaram muito bem!";
    }

    confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 }
    });

    telaVitoria.classList.remove("escondido");
}
