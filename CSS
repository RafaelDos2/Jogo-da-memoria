/* CSS Otimizado para Tablet & Responsividade Total */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
}

:root {
    --fundo: #0d0e1b;
    --painel: #16172d;
    --roxo: #7667ff;
    --azul: #438cff;
    --texto: #f4f3ff;
    --texto-secundario: #a4a7c5;
    --borda: #303251;
    --sucesso: #2e7d54;
}

html, body {
    width: 100vw;
    height: 100vh;
    overflow-x: hidden;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    background: radial-gradient(circle at center, #1e1b4b 0%, var(--fundo) 100%);
    color: var(--texto);
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    padding: 16px;
}

button {
    font: inherit;
    cursor: pointer;
}

.escondido {
    display: none !important;
}

/* Estrutura de Telas Adaptadas para Tablet (Portrait & Landscape) */
.menu, .tela-jogo {
    width: 100%;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: auto;
    padding: 10px 0;
}

.cabecalho {
    text-align: center;
    margin-bottom: 4px;
}

.icone-logo {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
    border: 2px solid #6659c9;
    border-radius: 18px;
    background: linear-gradient(135deg, #332c6e, #263f78);
    font-size: 32px;
    box-shadow: 0 6px 20px rgba(118, 103, 255, 0.3);
}

.cabecalho h1 {
    font-size: clamp(28px, 4.5vw, 38px);
    letter-spacing: -0.5px;
}

.cabecalho p {
    margin-top: 4px;
    color: var(--texto-secundario);
    font-size: 16px;
}

.modulo {
    padding: 16px 20px;
    border: 1px solid var(--borda);
    border-radius: 16px;
    background: rgba(25, 26, 49, 0.95);
    width: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}

.titulo-modulo {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
}

.numero {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid #5148a1;
    border-radius: 10px;
    background: #29264e;
    color: #a69cff;
    font-size: 16px;
    font-weight: bold;
}

.titulo-modulo h2 {
    font-size: 19px;
    margin-bottom: 2px;
}

.titulo-modulo p {
    color: var(--texto-secundario);
    font-size: 14px;
}

/* Grade de Opções Touch-Friendly para Tablets */
.opcoes-dificuldade {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
}

.opcoes-cartas {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
}

.opcoes-tema {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
}

.btn-interativo {
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.btn-interativo:active {
    transform: scale(0.96);
}

.opcao-dificuldade, .opcao-tema, .opcao-cartas {
    min-height: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 12px 8px;
    border: 2px solid var(--borda);
    border-radius: 12px;
    background: #1e2039;
    color: var(--texto);
    cursor: pointer;
}

.opcao-dificuldade:hover, .opcao-tema:hover, .opcao-cartas:hover {
    border-color: var(--roxo);
    background: #272746;
}

.opcao-dificuldade.selecionada, .opcao-tema.selecionado, .opcao-cartas.selecionada {
    border-color: var(--roxo);
    background: linear-gradient(145deg, #382f6e, #222b52);
    box-shadow: 0 0 15px rgba(118, 103, 255, 0.35);
}

.icone-opcao {
    font-size: 24px;
}

.opcao-dificuldade strong, .opcao-tema strong, .opcao-cartas strong {
    font-size: 15px;
}

.opcao-dificuldade small, .opcao-tema small, .opcao-cartas small {
    color: var(--texto-secundario);
    font-size: 12px;
    text-align: center;
}

.figuras {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 18px;
}

.area-jogar {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin: 10px 0;
    width: 100%;
}

#jogar, #btn-config-principal {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    font-weight: bold;
    font-size: 18px;
    cursor: pointer;
}

#jogar {
    border: none;
    background: linear-gradient(110deg, var(--roxo), var(--azul));
    color: white;
    box-shadow: 0 6px 20px rgba(118, 103, 255, 0.4);
    flex: 2;
}

#btn-config-principal {
    border: 2px solid var(--roxo);
    background: #25284a;
    color: var(--texto);
    flex: 1;
}

/* Área de Jogo Adaptada */
.cabecalho-jogo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: 14px;
    border: 1px solid var(--borda);
    background: var(--painel);
    width: 100%;
}

.cabecalho-jogo h2 {
    font-size: 20px;
}

.cabecalho-jogo p {
    color: var(--texto-secundario);
    font-size: 14px;
    margin-top: 2px;
}

.acoes-jogo {
    display: flex;
    gap: 10px;
}

.acoes-jogo button {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 10px;
    border: 1px solid var(--borda);
    background: #25284a;
    color: var(--texto);
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
}

.acoes-jogo button:hover {
    border-color: var(--roxo);
    background: #313563;
}

.painel-jogo {
    display: flex;
    justify-content: space-around;
    gap: 16px;
    padding: 14px;
    border-radius: 14px;
    border: 1px solid var(--borda);
    background: var(--painel);
    width: 100%;
    text-align: center;
}

.painel-jogo div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.painel-jogo span {
    color: var(--texto-secundario);
    font-size: 14px;
}

.painel-jogo strong {
    font-size: 20px;
    color: var(--texto);
}

/* Tabuleiro Fluido Responsivo p/ Tablet */
.tabuleiro {
    display: grid;
    gap: 12px;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    justify-content: center;
    justify-items: center;
    align-items: center;
    padding: 10px 0;
}

.carta {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    perspective: 1000px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s ease;
}

.carta:not(:disabled):active {
    transform: scale(0.95);
}

.carta .frente-carta, .carta .verso-carta {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.35s cubic-bezier(0.4, 0.2, 0.2, 1), box-shadow 0.3s ease;
    border: 2px solid var(--borda);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.3);
    font-size: clamp(2rem, 6vw, 3.5rem);
}

.carta .frente-carta {
    background: #25284a;
    color: #a69cff;
}

.carta .verso-carta {
    background: #1e2039;
    transform: rotateY(180deg);
}

.carta.virada .frente-carta {
    transform: rotateY(180deg);
}

.carta.virada .verso-carta {
    transform: rotateY(360deg);
    box-shadow: 0 0 20px rgba(67, 140, 255, 0.5);
    border-color: var(--azul);
}

.carta.encontrada .verso-carta {
    background: #1b382b;
    border-color: #2e7d54;
    box-shadow: 0 0 20px rgba(46, 125, 84, 0.6);
}

.carta.encontrada-ia .verso-carta {
    background: linear-gradient(135deg, #3a3f58 0%, #202336 100%);
    border-color: #b8c2cc;
    box-shadow: 0 0 20px rgba(184, 194, 204, 0.65);
    color: #e2e8f0;
}

.carta.erro .frente-carta, .carta.erro .verso-carta {
    border-color: #ff3333 !important;
    background: #3d1a1a !important;
    box-shadow: 0 0 20px #ff3333 !important;
}

#mensagem-jogo {
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    width: 100%;
    padding: 8px 0;
    transition: color 0.3s ease;
}

.turno-jogador {
    color: var(--azul) !important;
}

.turno-ia {
    color: var(--texto-secundario) !important;
}

/* Modais Otimizados para Tablet */
.modal-vitoria, .modal-config {
    position: fixed;
    inset: 0;
    background: rgba(11, 12, 24, 0.85);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 20px;
}

.conteudo-vitoria, .conteudo-config {
    background: #191a31;
    border: 2px solid var(--roxo);
    border-radius: 20px;
    padding: 30px 24px;
    width: 100%;
    max-width: 460px;
    text-align: center;
    box-shadow: 0 0 40px rgba(118, 103, 255, 0.4);
}

.icone-vitoria {
    font-size: 56px;
    margin-bottom: 10px;
}

.conteudo-vitoria h2, .conteudo-config h2 {
    font-size: 26px;
    margin-bottom: 14px;
}

.conteudo-vitoria p {
    font-size: 16px;
    color: var(--texto-secundario);
    margin-bottom: 20px;
}

.config-grupo {
    margin: 18px 0;
    text-align: left;
}

.config-grupo label {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: var(--texto-secundario);
    margin-bottom: 8px;
}

.config-grupo input[type="range"] {
    width: 100%;
    accent-color: var(--roxo);
    cursor: pointer;
    height: 10px;
    background: #29264e;
    border-radius: 5px;
}

.estatisticas-vitoria {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 24px;
}

.stat-box {
    background: #13152a;
    border: 1px solid var(--borda);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.stat-box span {
    font-size: 13px;
    color: var(--texto-secundario);
}

.stat-box strong {
    font-size: 20px;
    color: var(--texto);
}

.botoes-vitoria {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.btn-primario, .btn-secundario {
    min-height: 52px;
    border-radius: 12px;
    font-weight: bold;
    font-size: 17px;
    cursor: pointer;
}

.btn-primario {
    background: linear-gradient(110deg, var(--roxo), var(--azul));
    color: white;
    border: none;
    box-shadow: 0 4px 15px rgba(118, 103, 255, 0.3);
}

.btn-secundario {
    background: #25284a;
    color: var(--texto);
    border: 1px solid var(--borda);
}

footer {
    margin-top: 10px;
    color: #777b9c;
    font-size: 12px;
    letter-spacing: 2px;
    text-align: center;
}

footer span {
    color: var(--roxo);
    margin: 0 4px;
}

/* Ajustes específicos para Tablet (Media Queries) */
@media (min-width: 768px) and (max-width: 1024px) {
    html, body {
        padding: 20px;
    }
    .menu, .tela-jogo {
        max-width: 760px;
    }
}
